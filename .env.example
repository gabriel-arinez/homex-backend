DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://homex:homex@127.0.0.1:5432/homex
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Producción privada inicial. Deploy monta el directorio persistente del host
# dentro del contenedor en /var/lib/homex/media.
HOMEX_MEDIA_STORAGE=filesystem
HOMEX_MEDIA_ROOT=/var/lib/homex/media
HOMEX_MEDIA_URL=/media/

# La topología Zero Trust/Tunnel inicial no necesita un hostname HTTPS público.
# Activar sólo cuando deploy entregue un endpoint HTTPS real.
HOMEX_HTTPS_ENABLED=0

# Storage S3/R2 opcional para crecimiento futuro.
# Sólo son obligatorias si HOMEX_MEDIA_STORAGE=s3.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=homex-public-media
HOMEX_MEDIA_PUBLIC_DOMAIN=media.example.com

# F08.2 — worker ASR/NLP y temporales privados (fuera de backups)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
HOMEX_AUDIO_TEMP_ROOT=/var/lib/homex/audio-temporal
HOMEX_AUDIO_MAX_BYTES=25000000
HOMEX_AUDIO_TTL_SECONDS=3600
HOMEX_OUTBOX_RECONCILE_SECONDS=3600
HOMEX_ASR_MODEL_PATH=/opt/homex/models/faster-whisper-small
HOMEX_ASR_DEVICE=cpu
HOMEX_ASR_COMPUTE_TYPE=int8
